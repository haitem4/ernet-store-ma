# ============================================================
# ERNET STORE — Variables d'environnement (copier vers .env)
# ============================================================

# Serveur
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:4000

# Base de données PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ernetstore

# Redis (cache temps réel + BullMQ queues)
REDIS_URL=redis://localhost:6379

# Meilisearch (moteur de recherche)
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=masterKey

# Authentification JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
JWT_COOKIE_NAME=ernet_token

# CMI (paiement Maroc) — à compléter avec vos identifiants
CMI_MERCHANT_ID=
CMI_SECRET_KEY=
CMI_GATEWAY_URL=https://www.cmi.co.ma

# Disway — import automatique des tarifs fournisseur
DISWAY_LOGIN_URL=https://www.disway.com/profile/login?backurl=%2Fliste-de-prix
DISWAY_PRICE_LIST_URL=https://www.disway.com/liste-de-prix
DISWAY_XLSX_URL=
DISWAY_EMAIL=
DISWAY_PASSWORD=
DISWAY_MARKUP=1.2
DISWAY_AUTO_SYNC=false
DISWAY_AUTO_SYNC_MONTHLY=false
DISWAY_AUTO_SYNC_TIME=04:00
DISWAY_SYNC_INTERVAL_MS=86400000

# Stockage fichiers (S3 / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ernetstore

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@ernetstore.com

# Webhooks fournisseurs (optionnel)
SUPPLIER_WEBHOOK_SECRET=change-me

