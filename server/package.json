{
  "name": "server",
  "version": "1.0.0",
  "description": "ERNERSTORE API — Node.js + Express + PostgreSQL + Redis + Meilisearch + Socket.IO",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test src/utils/slug.test.js src/utils/auth.test.js src/services/cmi.test.js src/services/pricing.test.js",
    "disway:import": "node run-import.js",
    "disway:sync": "node sync-disway.js",
    "disway:sync:dry": "node sync-disway.js --dry-run",
    "disway:sync:local": "node sync-disway.js --local",
    "disway:sync:clear": "node sync-disway.js --clear",
    "seed": "node prisma/seed.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "meilisearch": "^0.38.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "puppeteer": "^24.43.1",
    "socket.io": "^4.7.4",
    "vite": "8.2.1",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prisma": "^5.10.2"
  }
}
